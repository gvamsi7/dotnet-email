<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>ISH.CustomerPortal.Infrastructure</AssemblyName>
    <!-- Deliberately different: the resource must not depend on RootNamespace. -->
    <RootNamespace>Verification.Infrastructure</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../Application.CompileCheck/Application.CompileCheck.csproj" />
    <PackageReference Include="MailKit" Version="4.17.0" />
    <Compile Include="../../source-code/ISH.CustomerPortal.Infrastructure/**/*.cs" />
    <EmbeddedResource Include="../../source-code/ISH.CustomerPortal.Infrastructure/Email/Templates/Feedback.html">
      <LogicalName>ISH.CustomerPortal.Infrastructure.Email.Templates.Feedback.html</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
