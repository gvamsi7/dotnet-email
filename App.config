<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <appSettings>
    <!-- Replace these with the settings supplied by your mail administrator. -->
    <add key="Smtp.Host" value="smtp.example.com" />
    <add key="Smtp.Port" value="587" />
    <!-- StartTls (usually 587) or SslOnConnect (usually 465). TLS is required. -->
    <add key="Smtp.Security" value="StartTls" />
    <!-- Password, OAuth2, or None for an administrator-approved TLS relay. -->
    <add key="Smtp.Authentication" value="Password" />
    <add key="Smtp.Username" value="noreply@example.com" />
    <add key="Smtp.TimeoutSeconds" value="60" />
    <!-- Credentials are read from FEEDBACK_SMTP_PASSWORD or FEEDBACK_SMTP_ACCESS_TOKEN. -->
    <add key="Email.FromAddress" value="noreply@example.com" />
    <add key="Email.FromName" value="Industrial Services Hub" />
    <add key="Email.ToAddress" value="feedback@example.com" />
    <add key="Email.ApplicationName" value="Industrial Services Hub" />
    <add key="Email.CompanyName" value="Schneider Electric" />
    <add key="Email.CopyrightOwner" value="Schneider Electric Industries SAS" />
    <add key="Email.TimeZoneId" value="India Standard Time" />
    <!-- Set an absolute server-side path to your approved PNG/JPG logo; empty uses text. -->
    <add key="Email.LogoFilePath" value="" />
    <!-- Empty values render plain text; set your application's real HTTPS URLs. -->
    <add key="Email.TermsUrl" value="" />
    <add key="Email.PrivacyUrl" value="" />
  </appSettings>
</configuration>
